# Hedera (testnet only, see CLAUDE.md constraint 6)
# Create a free testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
# Second testnet account — acts as charity placeholder recipient
CHARITY_ACCOUNT_ID=
# Third testnet account — escrow holding until appeal window closes
PENDING_ACCOUNT_ID=
HEDERA_STREAK_TOKEN_ID= # run `pnpm tsx scripts/create-token.ts` once to create and populate this
APPEAL_WINDOW_MS= # defaults to 60000 (1 min) for demo mode; production would be closer to an hour
# Run `pnpm exec tsx scripts/create-topic.ts` after setting HEDERA_ACCOUNT_ID + HEDERA_PRIVATE_KEY
HEDERA_HCS_TOPIC_ID=

# 0G Compute (Focus Coach)
#
# Two paths. Setting ZG_ROUTER_API_KEY selects the Router; otherwise the broker
# is used. The Router exists because broker.ledger.addLedger() enforces a 3 OG
# minimum that the 0.1/day faucet cannot reach, while the Router bills a unified
# balance with no floor. Trade-off: the broker verifies response attestation,
# the Router returns none — so only the broker path is TEE-verified.
#
# Broker path (wallet + on-chain ledger)
ZG_PRIVATE_KEY=
ZG_RPC_URL=
# Optional: pin to a specific chat-capable provider address after validating on testnet
ZG_PROVIDER_ADDRESS=
#
# Router path (API key + prepaid balance). Create a key and deposit at
# https://pc.testnet.0g.ai — note the `testnet`; pc.0g.ai is a separate mainnet
# environment with its own keys and balance.
ZG_ROUTER_API_KEY=
# Both optional; these are the defaults compiled into src/ai/coach.ts
ZG_ROUTER_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_MODEL=qwen2.5-omni

# World App (Mini App auth, verification, actions)
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the Developer Portal
WORLD_APP_ID=
WORLD_ACTION_ID=
WORLD_DEV_PORTAL_API_KEY=
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# Auth.js (wallet auth session)
AUTH_SECRET="" # Generate once with `openssl rand -base64 32` and paste here
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
# World App on a phone needs a public HTTPS origin. In a Codespace you already
# have one and do not need ngrok — it is the forwarded port 3000 URL:
#   echo "https://$CODESPACE_NAME-3000.app.github.dev"
# Port 3000 must be set to PUBLIC visibility in the Ports panel, or the phone
# gets a GitHub login wall instead of the app. devcontainer.json asks for this
# but the setting does not always stick, so check it.
# Outside a Codespace, use an ngrok tunnel (https://xxxx.ngrok-free.dev), or
# your production URL after deploy.
AUTH_URL=''
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`

# Coach model providers
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# App environment
# Set to "development" locally; controls Eruda devtools overlay
NEXT_PUBLIC_APP_ENV=development
# Set to "true" to bypass Hedera + 0G calls during local UI development
NEXT_PUBLIC_DEMO_MODE=true
