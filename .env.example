# Hedera (testnet only, see CLAUDE.md constraint 6)
# Get a testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
# Create two additional testnet accounts on the portal for escrow and charity
CHARITY_ACCOUNT_ID=
PENDING_ACCOUNT_ID=
APPEAL_WINDOW_MS= # defaults to 60000 (1 min) for demo mode; production would be closer to an hour
# Run `pnpm exec tsx scripts/check-hedera.ts` (or the Hedera portal) to create a topic, then paste the ID here
HEDERA_HCS_TOPIC_ID=

# 0G Compute (Focus Coach)
ZG_PRIVATE_KEY=
ZG_RPC_URL=

# World App (Mini App auth, verification, actions)
# Get these from https://developer.worldcoin.org
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the Developer Portal
WORLD_APP_ID=
WORLD_ACTION_ID=
WORLD_DEV_PORTAL_API_KEY=
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# Auth.js (wallet auth session)
AUTH_SECRET="" # Run: openssl rand -base64 32
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
AUTH_URL='' # Set to your ngrok URL for testing (e.g. https://xxxx.ngrok-free.dev), your Codespace URL (e.g. https://{name}-3000.app.github.dev), or your production URL after deploy
HMAC_SECRET_KEY='some-secret' # Run: openssl rand -base64 32

# App environment — controls Eruda in-app debugger
# Set to "development" locally and "production" on deploy
NEXT_PUBLIC_APP_ENV=development

# Demo mode — true = 30 s sessions (hackathon demo), false = 25 min sessions
NEXT_PUBLIC_DEMO_MODE=true

# Coach model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
