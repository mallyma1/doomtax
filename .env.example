# Hedera (testnet only, see CLAUDE.md constraint 6)
# Create a free testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
# Second testnet account — acts as charity placeholder recipient
CHARITY_ACCOUNT_ID=
# Third testnet account — escrow holding until appeal window closes
PENDING_ACCOUNT_ID=
HEDERA_STREAK_TOKEN_ID= # run `pnpm tsx scripts/create-token.ts` once to create and populate this
APPEAL_WINDOW_MS= # defaults to 86400000 (24h). Set 60000 for a live demo, so the sweep is showable
# Run `pnpm exec tsx scripts/create-topic.ts` after setting HEDERA_ACCOUNT_ID + HEDERA_PRIVATE_KEY
HEDERA_HCS_TOPIC_ID=

# 0G Compute (Focus Coach)
#
# Two paths. Setting a compute API key selects the OpenAI-compatible HTTPS path;
# otherwise the broker is used. The API-key path swaps wallet signing and an
# on-chain ledger for a bearer key and prepaid balance — a simpler server-side
# integration.
#
# It does NOT dodge the funding requirement: the testnet Router enforces the
# same 3 OG minimum deposit as broker.ledger.addLedger(). Both paths are blocked
# by the same 3 OG, and the 0.1/day faucet reaches neither.
#
# Trade-off: the broker verifies response attestation, the API-key path returns
# none — so only the broker path is TEE-verified.
#
# Broker path (wallet + on-chain ledger)
ZG_PRIVATE_KEY=
ZG_RPC_URL=
# Optional: pin to a specific chat-capable provider address after validating on testnet
ZG_PROVIDER_ADDRESS=
#
# API-key path (Router or provider-scoped endpoint).
# Examples:
# - Mainnet Router: https://router-api.0g.ai/v1
# - Testnet Router: https://router-api-testnet.integratenetwork.work/v1
# - Provider-scoped endpoint from pc.0g.ai: https://compute-network-27.integratenetwork.work
# Set ZG_NETWORK when the URL itself is ambiguous (for example compute-network-*).
ZG_COMPUTE_API_KEY=
ZG_COMPUTE_URL=
ZG_COMPUTE_MODEL=qwen2.5-omni
ZG_NETWORK=
# Legacy aliases still supported by the codebase:
ZG_ROUTER_API_KEY=
ZG_ROUTER_URL=
ZG_ROUTER_MODEL=

# World App (Mini App auth, verification, actions)
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the Developer Portal
WORLD_APP_ID=
WORLD_ACTION_ID=
# Claim-time Selfie Check. Must be a SEPARATE action from WORLD_ACTION_ID:
# that one is bound to the orbLegacy preset via the Verify component, and
# World's docs are explicit that changing the credential means a new action.
# Create it in the Developer Portal (suggested id: doomtax-claim). Selfie Check
# is in Beta and may need enabling on the app before it will issue.
# Unset simply hides the step — the claim still settles (see docs/SELFIE-CHECK-SPEC.md).
WORLD_SELFIE_ACTION_ID=
WORLD_DEV_PORTAL_API_KEY=
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# Auth.js (wallet auth session)
AUTH_SECRET="" # Generate once with `openssl rand -base64 32` and paste here
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
# World App on a phone needs a public HTTPS origin. In a Codespace you already
# have one and do not need ngrok — it is the forwarded port 3000 URL:
#   echo "https://$CODESPACE_NAME-3000.app.github.dev"
# Port 3000 must be set to PUBLIC visibility in the Ports panel, or the phone
# gets a GitHub login wall instead of the app. devcontainer.json asks for this
# but the setting does not always stick, so check it.
# Outside a Codespace, use an ngrok tunnel (https://xxxx.ngrok-free.dev), or
# your production URL after deploy.
AUTH_URL=''
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`

# Coach model providers
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# App environment
# Set to "development" locally; controls Eruda devtools overlay
NEXT_PUBLIC_APP_ENV=development
# Set to "true" to bypass Hedera + 0G calls during local UI development
NEXT_PUBLIC_DEMO_MODE=true
